# Zig build artifacts and cache
.zig-cache/
zig-out/
zig-pkg/

# Ignore unused PDF Oxide files and artifacts
native_pdf_oxide/
pdf_oxide_engine.dll
pdf_oxide_html_test/
oxide_bridge.py

# Embedded UI bundle
ui/
src/embedded_ui/
Screens UI/

# Embedded vendor binaries (needed for main.zig @embedFile)
!src/embedded_bins/
!src/embedded_bins/pdfium.dll
!src/embedded_bins/WebView2Loader.dll

# Node / Frontend build artifacts & dependencies
**/node_modules/
**/dist/
**/dist-ssr/
*.tsbuildinfo

# Binary executables and library files (excluding embedded vendor binaries)
*.exe
*.dll
!src/embedded_bins/*.dll
*.so
*.dylib
*.pdb
*.lib
*.obj
*.o
*.a

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp

# Operating system & IDE files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Environment variables
.env
.env.*
!.env.example
